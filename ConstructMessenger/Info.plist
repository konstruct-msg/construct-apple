<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.construct.message-refresh</string>
		<string>com.construct.maintenance</string>
	</array>
	<key>CFBundleGetInfoString</key>
	<string></string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>cc.konstruct.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>konstruct</string>
			</array>
		</dict>
	</array>
	<key>GRPC_HOST</key>
	<string>$(GRPC_HOST)</string>
	<key>GRPC_PORT</key>
	<string>$(GRPC_PORT)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Construct uses the camera to scan invite QR codes and to capture photos and videos for your messages.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Construct needs access to your photo library so you can attach photos and videos to messages.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Construct saves photos and videos to your library when you choose to save them from a chat.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Construct uses the microphone to record voice messages and make encrypted calls.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>To transcribe your voice messages into text on-device using Apple’s Speech Recognition. Audio never leaves your device.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Construct Messenger sends you notifications for new messages.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used to transfer your backup directly to a nearby device over WiFi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_construct-transfer._tcp</string>
		<string>_construct-veil._tcp</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<!--
	  Construct uses non-exempt encryption (custom E2EE + post-quantum ML-KEM/ML-DSA).
	  Qualifies for the mass-market exemption under EAR 740.17(b)(1); requires an annual
	  self-classification report to BIS + NSA (and a French declaration where applicable).
	  See decisions/export-compliance-encryption.md. Do NOT revert to false.
	-->

</dict>
</plist>
