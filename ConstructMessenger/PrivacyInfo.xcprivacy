<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Construct is E2EE and performs no cross-app tracking. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  An EMPTY array here is not a blank to be filled in later — it is the positive claim
	  "Data Not Collected", and for Construct it was very slightly untrue.

	  Apple's definition of "collect" is not "hold personal data" and not "track". It is:
	  transmitting data off the device such that the developer or its partners can access it
	  for longer than is needed to service the request in real time. Two things Construct
	  sends meet that definition — both purely so the product works, neither for tracking,
	  and Apple's vocabulary has no way to say "and we cannot read any of it".

	  What is deliberately NOT declared, so the omission is visible rather than forgotten:

	    · User Content. The server's offline queue holds ciphertext until the recipient
	      collects it — retained beyond real time, and therefore arguably collected, but it
	      is E2EE and unreadable by us. Apple publishes no exception for encryption. This is
	      an open developer judgement call (see below), not an oversight.
	    · Usage Data / Diagnostics / Analytics. Genuinely none: no analytics SDK, and the
	      MetricKit crash reports stay on device, leaving only when the user shares them
	      (CrashDiagnosticsCollector → LogCollector.createLogArchive).
	    · Contact Info. Registration takes a username, not an email or phone number.

	  These entries must AGREE with the App Store Connect privacy nutrition labels, which are
	  the binding form (this manifest feeds the privacy report). Copy them across at A2.4:
	  both are "App Functionality", both "Linked to You", both "Not used for tracking".
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- Account identifier (ServerUserId). Every session address, contact list and
			     routing decision is keyed by it, so the server necessarily stores it. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- APNs and PushKit/VoIP tokens, registered against the account by
			     NotificationServiceClient.registerDeviceToken / registerVoipToken and stored
			     server-side keyed by user_id. Without this the device cannot be woken for a
			     message or an incoming call. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<!-- Required Reason APIs actually used (audited 2026-07-24). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaults: app settings / flags, read+write within the app. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- File timestamps: media/attachment metadata for display and ordering.
			     Real call sites: MediaManager (cache eviction ordered by
			     .contentModificationDate), MediaAssetExporter and MessageValidator
			     (attributesOfItem for size/date). -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- System boot time: `ProcessInfo.processInfo.systemUptime`, used ONLY as a
			     monotonic clock for measuring intervals inside the app — never read as a
			     device characteristic and never sent anywhere.

			     Call sites (audited 2026-08-11):
			       · RuntimeDiagnostics.cpuSample — the elapsed side of the CPU rate; a
			         monotonic source is required there precisely so a wall-clock adjustment
			         mid-interval cannot distort the reading (see CPUUsageRate).
			       · ChatScrollManager.noteComposerHeightChanged and the scroll-settle check —
			         debounce windows.

			     Reason 35F9.1: "measure the amount of time that has elapsed between events
			     that occurred within the app". Missing this declaration is ITMS-91053 on
			     submission, and it was missing: `systemUptime` arrived in the diagnostics on
			     2026-08-08 and in ChatScrollManager earlier, while this file was last audited
			     2026-07-24. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
