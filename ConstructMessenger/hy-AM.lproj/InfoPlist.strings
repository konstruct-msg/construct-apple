"CFBundleDisplayName" = "Konstruct";
"NSCameraUsageDescription" = "Konstruct-ը տեսախցիկն օգտագործում է հրավերի QR կոդերը սկանավորելու, հաղորդագրությունների համար լուսանկարներ և տեսանյութեր նկարելու և տեսազանգերի համար։";
"NSPhotoLibraryUsageDescription" = "Konstruct-ին անհրաժեշտ է մուտք ձեր լուսանկարների գրադարան, որպեսզի կարողանաք հաղորդագրություններին կցել լուսանկարներ և տեսանյութեր։";
"NSPhotoLibraryAddUsageDescription" = "Konstruct-ը լուսանկարներն ու տեսանյութերը պահում է ձեր գրադարանում, երբ ընտրում եք դրանք պահել զրույցից։";
"NSMicrophoneUsageDescription" = "Konstruct-ը խոսափողն օգտագործում է ձայնային հաղորդագրություններ ձայնագրելու և գաղտնագրված զանգեր կատարելու համար։";
"NSSpeechRecognitionUsageDescription" = "Ձեր ձայնային հաղորդագրությունները սարքի վրա տեքստի վերածելու համար՝ Apple-ի խոսքի ճանաչման միջոցով։ Ձայնը երբեք չի լքում ձեր սարքը։";
"NSLocalNetworkUsageDescription" = "Օգտագործվում է ձեր պահուստային պատճենը Wi-Fi-ով անմիջապես մոտակա սարքին փոխանցելու համար։";
"NSFaceIDUsageDescription" = "Konstruct-ը Face ID-ն օգտագործում է հավելվածը բացելու և ձեր վերականգնման արտահայտությունը պաշտպանելու համար։";
