{
  "$schema_version": 1,
  "$authority": "construct-core :: crypto::device_certificate",
  "$spec": "construct-docs/decisions/devices-of-an-account-sign-each-other.md",
  "$purpose": [
    "Which devices belong to an account is otherwise only the server's word. When the owner links a",
    "device, the old one signs the new one's keys; a peer that trusts the old device trusts the new",
    "one through the signature, and a device nobody signed is the one the alarm is about.",
    "Two implementations that build the signed message differently do not fail loudly: every honest",
    "device reads as unsigned on the other client, and the alarm becomes noise again.",
    "These values come from construct-core, the first implementation (2026-10-23); check_device_certificate.py",
    "rebuilds every byte string except the signatures from the prose below with the standard library."
  ],
  "$construction": {
    "device_id": "SHA-256(identity X25519 public)[0..16]; lowercase hex where a string",
    "qr_fingerprint": "SHA-256(identity X25519 public || hybrid public) -> 32 bytes (history_qr_fingerprint)",
    "message": "\"KonstruktDeviceCert-v1\" || 0x00 || signer_device_id (16) || subject_device_id (16) || subject identity X25519 (32) || subject verifying Ed25519 (32) || subject hybrid public (1984) || issued_at (u64 BE)",
    "signature": "hybrid Ed25519 (64) || ML-DSA-65 (3309) over message, by the signer's hybrid identity key; both halves deterministic",
    "certificate": "0x01 || signer_device_id (16) || issued_at (u64 BE) || signer hybrid public (1984) || signature (3373) \u2014 exactly 5382 bytes; any other length or version is not a certificate",
    "link_key_proof": "HMAC-SHA256(secret (32), \"KonstruktLinkProof-v1\" || 0x00 || qr_fingerprint(identity, hybrid)) \u2014 Flow A; the secret is in the old device's QR and never sent to the server",
    "hybrid_binding": "Ed25519 by verifying key over \"KonstruktHybridId-v1\" || hybrid public (bundle field hybrid_identity_signature); checked before a certificate is issued or judged"
  },
  "$keys_from_seeds": "device seed s: X25519 secret = [s]*32; Ed25519 seed = [s+100]*32; hybrid key = Ed25519 seed [s+50]*32, ML-DSA-65 seed [s]*32. signer = seed 1, subject = seed 2.",
